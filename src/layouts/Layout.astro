---
interface Props {
	title: string;
}

const { title } = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Cameron Jones - CyberSecurity Student Portfolio"
		/>
		<meta name="viewport" content="width=device-width" />

		<!-- OpenGraph / Social Sharing tags (intentially blank to remove preview) -->
		<meta property="og:image" content="" />
		<meta property="og:title" content="" />

		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body
		class="bg-slate-900 text-slate-200 font-sans antialiased selection:bg-blue-500/30"
	>
		<div
			class="fixed inset-0 z-[-1] pointer-events-none bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-[#0f172a] to-black"
		>
		</div>

		<header
			class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md fixed top-0 w-full z-50"
		>
			<div
				class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between"
			>
				<a
					href="/"
					class="text-lg font-bold text-slate-100 hover:text-blue-400 transition-colors"
				>
					Cameron Jones
				</a>
				<nav
					class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-400"
				>
					<a href="/" class="hover:text-blue-400 transition-colors"
						>Home</a
					>
					<a
						href="/experience"
						class="hover:text-blue-400 transition-colors"
						>Experience</a
					>
					<a
						href="/projects"
						class="hover:text-blue-400 transition-colors"
						>Projects</a
					>
					<a
						href="/blog"
						class="hover:text-blue-400 transition-colors">Blog</a
					>
					<a
						href="/resume"
						class="hover:text-blue-400 transition-colors"
					>
						Resume
					</a>
				</nav>

				<!-- Mobile Menu Button -->
				<button
					id="mobile-menu-btn"
					class="md:hidden text-slate-400 hover:text-white focus:outline-none p-2"
					aria-label="Toggle menu"
					aria-expanded="false"
				>
					<!-- Hamburger Icon -->
					<svg
						id="menu-icon"
						xmlns="http://www.w3.org/2000/svg"
						class="h-6 w-6"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
					<!-- Close Icon -->
					<svg
						id="close-icon"
						xmlns="http://www.w3.org/2000/svg"
						class="h-6 w-6 hidden"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		</header>

		<!-- Mobile Menu Overlay -->
		<div
			id="mobile-menu"
			class="fixed top-16 left-0 right-0 bottom-0 z-40 bg-slate-900 border-t border-slate-800 transform translate-x-full transition-transform duration-300 md:hidden flex flex-col items-center justify-start pt-12 pb-8 space-y-8 overflow-y-auto"
		>
			<nav class="flex flex-col items-center gap-8 w-full px-8">
				<a
					href="/"
					class="mobile-link text-2xl font-bold text-slate-300 hover:text-blue-400 transition-colors w-full text-center py-2 border-b border-slate-800/50"
					>Home</a
				>
				<a
					href="/experience"
					class="mobile-link text-2xl font-bold text-slate-300 hover:text-blue-400 transition-colors w-full text-center py-2 border-b border-slate-800/50"
					>Experience</a
				>
				<a
					href="/projects"
					class="mobile-link text-2xl font-bold text-slate-300 hover:text-blue-400 transition-colors w-full text-center py-2 border-b border-slate-800/50"
					>Projects</a
				>
				<a
					href="/blog"
					class="mobile-link text-2xl font-bold text-slate-300 hover:text-blue-400 transition-colors w-full text-center py-2 border-b border-slate-800/50"
					>Blog</a
				>
				<a
					href="/resume"
					class="mobile-link text-2xl font-bold text-blue-400 hover:text-blue-300 transition-colors w-full text-center py-2 border-b border-slate-800/50"
					>Resume</a
				>
			</nav>

			<div class="flex gap-8 mt-auto pb-8">
				<a
					href="https://github.com/Crayjones"
					target="_blank"
					class="text-slate-500 hover:text-blue-400 transition-colors"
				>
					<span class="sr-only">GitHub</span>
					<svg
						class="h-6 w-6"
						fill="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							fill-rule="evenodd"
							d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
							clip-rule="evenodd"></path>
					</svg>
				</a>
				<a
					href="https://linkedin.com/in/cameron-ray-jones"
					target="_blank"
					class="text-slate-500 hover:text-blue-400 transition-colors"
				>
					<span class="sr-only">LinkedIn</span>
					<svg
						class="h-6 w-6"
						fill="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							fill-rule="evenodd"
							d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
							clip-rule="evenodd"></path>
					</svg>
				</a>
			</div>
		</div>

		<main
			class="pt-20 md:pt-24 max-w-5xl mx-auto px-4 min-h-[calc(100vh-6rem)]"
		>
			<slot />
		</main>

		<footer
			class="border-t border-slate-800 mt-20 py-8 text-center text-slate-500 text-sm"
		>
			<div class="flex justify-center gap-6 mb-4">
				<a
					href="https://github.com/Crayjones"
					target="_blank"
					class="hover:text-blue-400 transition-colors">GitHub</a
				>
				<a
					href="https://linkedin.com/in/cameron-ray-jones"
					target="_blank"
					class="hover:text-blue-400 transition-colors">LinkedIn</a
				>
				<a
					href="mailto:crayjones2007@gmail.com"
					class="hover:text-blue-400 transition-colors">Email</a
				>
			</div>
			<p>
				&copy; {new Date().getFullYear()} Cameron Jones. Built with Astro.
			</p>
		</footer>
		<script>
			const mobileMenuBtn = document.getElementById("mobile-menu-btn");
			const mobileMenu = document.getElementById("mobile-menu");
			const menuIcon = document.getElementById("menu-icon");
			const closeIcon = document.getElementById("close-icon");
			const mobileLinks = document.querySelectorAll(".mobile-link");

			function toggleMenu() {
				const isClosed =
					mobileMenu?.classList.contains("translate-x-full");
				if (isClosed) {
					// Open
					mobileMenu?.classList.remove("translate-x-full");
					document.body.classList.add("overflow-hidden");
					mobileMenuBtn?.setAttribute("aria-expanded", "true");
					menuIcon?.classList.add("hidden");
					closeIcon?.classList.remove("hidden");
				} else {
					// Close
					mobileMenu?.classList.add("translate-x-full");
					document.body.classList.remove("overflow-hidden");
					mobileMenuBtn?.setAttribute("aria-expanded", "false");
					menuIcon?.classList.remove("hidden");
					closeIcon?.classList.add("hidden");
				}
			}

			mobileMenuBtn?.addEventListener("click", toggleMenu);

			// Close menu when a link is clicked
			mobileLinks.forEach((link) => {
				link.addEventListener("click", toggleMenu);
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
	}
	html {
		scroll-behavior: smooth;
	}
	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 10px;
	}
	::-webkit-scrollbar-track {
		background: #0f172a;
	}
	::-webkit-scrollbar-thumb {
		background: #334155;
		border-radius: 5px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #475569;
	}
</style>
