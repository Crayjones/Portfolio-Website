---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<Layout title={title}>
    <article class="max-w-3xl mx-auto py-8 mb-20">
        <div class="mb-8">
            <a
                href="/blog"
                class="text-sm font-medium text-blue-500 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
            >
                &larr; Back to Blog
            </a>
        </div>

        <header class="mb-12 border-b border-slate-800 pb-8">
            <h1
                class="text-3xl md:text-5xl font-bold text-slate-100 mb-6 leading-tight"
            >
                {title}
            </h1>
            <p class="text-xl text-slate-400 leading-relaxed font-light mb-4">
                {description}
            </p>

            <div class="flex flex-wrap gap-4 items-center mb-4">
                <time
                    datetime={pubDate.toISOString()}
                    class="text-sm text-slate-500"
                >
                    {
                        pubDate.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>
                {
                    updatedDate && (
                        <span class="text-sm text-slate-500 italic">
                            (Updated: {updatedDate.toLocaleDateString("en-US")})
                        </span>
                    )
                }
            </div>

            {
                tags && (
                    <div class="flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-400 text-sm border border-slate-700">
                                #{tag}
                            </span>
                        ))}
                    </div>
                )
            }
        </header>

        <div
            class="prose prose-invert prose-lg prose-slate max-w-none
			prose-headings:text-slate-100 prose-headings:font-bold
			prose-p:text-slate-300 prose-p:leading-relaxed
			prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
			prose-strong:text-slate-100
			prose-li:text-slate-300
			prose-strong:text-slate-100
			prose-li:text-slate-300
			prose-img:w-full prose-img:rounded-xl prose-img:border prose-img:border-slate-800 prose-img:shadow-2xl
			prose-code:before:content-none prose-code:after:content-none
			prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800 prose-pre:text-base"
        >
            <slot />
        </div>
    </article>
</Layout>

<style is:global>
    /* Prose image overrides for full-width display */
    .prose img {
        margin-left: 0 !important;
        margin-right: 0 !important;
        max-width: 100% !important;
        height: auto !important;
    }

    /* Code block container styling */
    .prose pre {
        position: relative;
        background: #1a1a1a !important;
        border: 1px solid #2d2d2d !important;
        overflow-x: auto; /* Allow natural scrollbar behavior */
        padding: 1.5rem 4rem 1.5rem 1.5rem !important; /* Default uniform 1.5rem padding */
        transition: padding 0.2s ease; /* Smooth transition for padding changes */
    }

    /* Padding compensation when scrollbar is present */
    .prose pre.has-scrollbar {
        padding-bottom: 1rem !important; /* 1rem + 0.5rem scrollbar = 1.5rem visual total */
    }

    /* Remove background from code/words inside pre */
    .prose pre code,
    .prose pre code span {
        background-color: transparent !important;
        padding: 0;
        border: none;
    }

    /* Scrollbar Styling */
    .prose pre::-webkit-scrollbar {
        height: 8px; /* Fixed height for horizontal scrollbar */
    }

    /* Force track verification */
    .prose pre::-webkit-scrollbar-track {
        background: transparent;
    }

    .prose pre::-webkit-scrollbar-thumb {
        background: transparent; /* Hidden by default */
        border-radius: 20px;
        border: 2px solid transparent; /* padding around thumb */
        background-clip: content-box; /* makes thumb smaller than height */
        transition: background-color 0.2s;
    }

    /* Show scrollbar on code block hover */
    .prose pre:hover::-webkit-scrollbar-thumb {
        background-color: #475569; /* Slate-600 */
    }

    /* Scrollbar hover state - keep size constant but maybe darken thumb */
    .prose pre::-webkit-scrollbar:hover {
        /* constant height to prevent layout shift */
        height: 8px;
    }

    .prose pre::-webkit-scrollbar-thumb:hover {
        background-color: #64748b !important; /* Slate-500 */
        border-width: 1px; /* Make it fill more space */
    }

    /* Copy button adjustment for visibility */
    .copy-button {
        opacity: 0;
        transition: opacity 0.2s ease-in-out;
    }

    /* Show button when hovering the wrapper */
    .code-wrapper:hover .copy-button {
        opacity: 1;
    }

    /* Inline Code Styling - Obsidian-like Blue Theme */
    .prose :not(pre) > code {
        font-weight: 400 !important;
        background-color: #1a1a1a !important; /* Match large code block bg */
        padding: 0.2rem 0.375rem !important;
        border-radius: 0.375rem !important; /* Rounded-md */
        color: #60a5fa !important; /* Blue-400 */
        border: 1px solid #2d2d2d !important; /* Match large code block border */
    }

    /* Remove backticks if they are added by pseudo-elements */
    .prose :not(pre) > code::before,
    .prose :not(pre) > code::after {
        content: none !important;
    }

    /* Extract language from class name */
    .prose pre[class*="language-bash"]::before {
        content: "bash";
    }
    .prose pre[class*="language-sh"]::before {
        content: "shell";
    }
    .prose pre[class*="language-powershell"]::before {
        content: "powershell";
    }
    .prose pre[class*="language-python"]::before {
        content: "python";
    }
    .prose pre[class*="language-javascript"]::before {
        content: "javascript";
    }
    .prose pre[class*="language-typescript"]::before {
        content: "typescript";
    }
    .prose pre[class*="language-jsx"]::before {
        content: "jsx";
    }
    .prose pre[class*="language-tsx"]::before {
        content: "tsx";
    }
    .prose pre[class*="language-json"]::before {
        content: "json";
    }
    .prose pre[class*="language-yaml"]::before {
        content: "yaml";
    }
    .prose pre[class*="language-yml"]::before {
        content: "yaml";
    }
    .prose pre[class*="language-html"]::before {
        content: "html";
    }
    .prose pre[class*="language-css"]::before {
        content: "css";
    }
    .prose pre[class*="language-cpp"]::before {
        content: "c++";
    }
    .prose pre[class*="language-c"]::before {
        content: "c";
    }
    .prose pre[class*="language-go"]::before {
        content: "go";
    }
    .prose pre[class*="language-rust"]::before {
        content: "rust";
    }
    .prose pre[class*="language-java"]::before {
        content: "java";
    }
    .prose pre[class*="language-php"]::before {
        content: "php";
    }
    .prose pre[class*="language-ruby"]::before {
        content: "ruby";
    }
    .prose pre[class*="language-sql"]::before {
        content: "sql";
    }
    .prose pre[class*="language-plaintext"]::before,
    .prose pre[class*="language-text"]::before {
        content: "text";
    }

    /* Original copy-button styling, now overridden by new classes */
    .copy-button {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        padding: 0.375rem 0.75rem;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 0.375rem;
        color: #94a3b8;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.375rem;
        z-index: 10;
    }

    .copy-button:hover {
        background: #334155;
        color: #cbd5e1;
        border-color: #475569;
    }

    .copy-button.copied {
        background: #166534;
        border-color: #16a34a;
        color: #86efac;
    }
</style>

<script>
    function setupCodeBlocks() {
        const codeBlocks = document.querySelectorAll(".prose pre");

        codeBlocks.forEach((block) => {
            // Skip if already wrapped
            if (block.closest(".code-wrapper")) return;

            // Create wrapper and button
            const wrapper = document.createElement("div");
            wrapper.className = "code-wrapper relative group";
            block.parentNode?.insertBefore(wrapper, block);
            wrapper.appendChild(block);

            const button = document.createElement("button");
            button.className =
                "copy-button absolute top-3 right-3 p-2 w-8 h-8 flex items-center justify-center rounded-lg bg-slate-800/80 text-slate-400 hover:text-white hover:bg-slate-700 transition-all border border-slate-700/50 backdrop-blur-sm z-10 opacity-0 group-hover:opacity-100";
            button.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy transition-transform duration-200" style="min-width: 16px; width: 16px; height: 16px;"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            `;
            wrapper.appendChild(button);

            // ... copy button click handler ...
            button.addEventListener("click", async () => {
                const text = (block as HTMLElement).innerText;
                try {
                    await navigator.clipboard.writeText(text);

                    const originalContent = button.innerHTML;
                    button.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check text-green-400" style="min-width: 16px; width: 16px; height: 16px;"><path d="M20 6 9 17l-5-5"/></svg>
                    `;

                    setTimeout(() => {
                        button.innerHTML = originalContent;
                    }, 2000);
                } catch (err) {
                    console.error("Failed to copy:", err);
                    const originalContent = button.innerHTML;
                    button.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x text-red-400" style="min-width: 16px; width: 16px; height: 16px;"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    `;
                    setTimeout(() => {
                        button.innerHTML = originalContent;
                    }, 2000);
                }
            });

            // Overflow detection logic
            const updatePadding = () => {
                if (block.scrollWidth > block.clientWidth) {
                    block.classList.add("has-scrollbar");
                } else {
                    block.classList.remove("has-scrollbar");
                }
            };

            // Initial check
            updatePadding();

            // Observer for resize events
            const resizeObserver = new ResizeObserver(() => {
                updatePadding();
            });
            resizeObserver.observe(block);
        });
    }

    // Run on page load
    setupCodeBlocks();

    // Re-run on view transitions if using Astro view transitions
    document.addEventListener("astro:page-load", setupCodeBlocks);
</script>
