---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import profileImage from "../assets/LinkedinPic.jpg";

// 1. Get all blog posts
const allPosts = await getCollection("blog");
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 2. Get top projects
const allProjects = await getCollection("projects");
allProjects.sort((a, b) => {
	if (a.data.status === "active" && b.data.status !== "active") return -1;
	if (a.data.status !== "active" && b.data.status === "active") return 1;
	return a.data.title.localeCompare(b.data.title);
});
const featuredProjects = allProjects.slice(0, 3);

// Experiences moved to /experience page

const skills = [
	{
		category: "Offensive Security",
		items: ["Mythic C2", "Cobalt Strike", "Nmap", "Metasploit"],
	},
	{
		category: "Defensive Operations",
		items: ["Wireshark", "SysInternals", "Ghidra", "Autopsy"],
	},
	{
		category: "Infrastructure",
		items: [
			"Windows Server 2019/2022",
			"Active Directory",
			"Linux (Kali/Ubuntu)",
			"VMware ESXi",
			"Proxmox",
		],
	},
	{
		category: "Development",
		items: ["Python", "PowerShell", "Bash", "HTML/CSS", "JavaScript"],
	},
];

const certs = [
	{
		name: "Red Team Operator",
		issuer: "ZeroPoint Security",
		date: "Jan 2026",
		status: "Active",
		link: "https://certs.zeropointsecurity.co.uk/4eb8874a-0a28-4fd9-92b3-b66f0cffce0d",
	},
	{
		name: "GFACT",
		issuer: "GIAC",
		date: "Sep 2023",
		status: "Active",
		link: "https://www.credly.com/badges/94247615-4ad1-459c-9bc7-0fac9e66fb24/linked_in_profile",
	},
	{
		name: "ITF+",
		issuer: "CompTIA",
		date: "May 2022",
		status: "Active",
		link: "https://www.credly.com/badges/adca3d20-bcb8-4fee-be46-676835151853/linked_in_profile",
	},
];
---

<Layout title="Cameron Jones | CyberSecurity Student">
	<!-- Hero Section -->
	<section class="py-2 md:py-4">
		<div
			class="flex flex-col-reverse md:flex-row items-center gap-12 text-center md:text-left"
		>
			<div
				class="flex-1 space-y-6 flex flex-col items-center md:items-start"
			>
				<h1
					class="text-4xl md:text-6xl font-bold text-slate-100 tracking-tight"
				>
					Cameron Jones
				</h1>
				<p class="text-xl text-slate-400 max-w-2xl leading-relaxed">
					I am a Computer Science student at Tennessee Tech
					specializing in Cybersecurity. My focus is on offensive
					operations, incident response, and system hardening.
				</p>
				<div class="flex gap-4 pt-4 justify-center md:justify-start">
					<a
						href="/resume"
						class="px-6 py-3 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-500 transition-colors"
					>
						View Resume
					</a>
					<a
						href="mailto:crayjones2007@gmail.com"
						class="px-6 py-3 rounded-lg bg-slate-800 text-slate-200 font-semibold hover:bg-slate-700 transition-colors border border-slate-700"
					>
						Contact Me
					</a>
				</div>
			</div>

			<div
				class="relative w-48 h-48 md:w-64 md:h-64 shrink-0 rounded-full overflow-hidden border-2 border-slate-700 shadow-2xl bg-slate-800"
			>
				<Image
					src={profileImage}
					alt="Cameron Jones"
					class="object-cover w-full h-full"
					loading="eager"
				/>
			</div>
		</div>
	</section>

	<div class="flex flex-col-reverse md:grid md:grid-cols-3 gap-8 md:gap-12">
		<!-- Main Content -->
		<div class="md:col-span-2 space-y-12 md:space-y-20">
			<!-- Experience Section -->
			<!-- About & Education -->
			<div class="space-y-12">
				<section>
					<h2 class="text-xl font-bold text-slate-100 mb-6">
						Education
					</h2>
					<div
						class="bg-slate-800/30 rounded-xl p-6 border border-slate-700"
					>
						<div class="flex justify-between items-start mb-2">
							<h3 class="text-lg font-semibold text-slate-200">
								Tennessee Technological University
							</h3>
							<span class="text-sm text-slate-500 font-mono"
								>2025 - 2028</span
							>
						</div>
						<p class="text-blue-400 mb-2">
							Bachelor of Science in Computer Science
						</p>
						<div class="text-sm text-slate-400">
							<p>
								• GPA: <span class="text-slate-200 font-bold"
									>3.91</span
								>
							</p>
							<p>• Concentration: Cybersecurity</p>
						</div>
					</div>
				</section>

				<!-- Projects Section -->
				<section>
					<div class="flex items-center justify-between mb-6">
						<h2 class="text-xl font-bold text-slate-100">
							Select Projects
						</h2>
						<a
							href="/projects"
							class="text-sm text-blue-400 hover:text-blue-300 transition-colors"
						>
							View All &rarr;
						</a>
					</div>
					<div class="space-y-6">
						{
							featuredProjects.map((project) => (
								<article class="flex flex-col gap-4 border border-slate-800 rounded-xl p-6 bg-slate-800/30 hover:border-slate-700 transition-all group">
									<div class="flex items-start justify-between gap-4">
										<div class="flex-1">
											<div class="flex items-center gap-3 mb-2">
												<h3 class="text-xl font-bold text-slate-200 group-hover:text-blue-400 transition-colors">
													<a
														href={`/projects/${project.slug}`}
													>
														{project.data.title}
													</a>
												</h3>
												<span
													class={`px-2 py-0.5 rounded-full text-[10px] font-medium border uppercase tracking-wide ${
														project.data.status ===
														"active"
															? "bg-green-500/10 text-green-500 border-green-500/20"
															: project.data
																		.status ===
																  "completed"
																? "bg-blue-500/10 text-blue-500 border-blue-500/20"
																: "bg-slate-500/10 text-slate-500 border-slate-500/20"
													}`}
												>
													{project.data.status}
												</span>
											</div>
											<p class="text-slate-400 text-sm leading-relaxed mb-3 line-clamp-2">
												{project.data.description}
											</p>
											{project.data.tags && (
												<div class="flex flex-wrap gap-2 mb-4">
													{project.data.tags
														.slice(0, 3)
														.map((tag) => (
															<span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 text-xs border border-slate-700">
																{tag}
															</span>
														))}
												</div>
											)}
											<div class="mt-auto pt-2">
												<a
													href={`/projects/${project.slug}`}
													class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-700 text-slate-200 font-semibold hover:bg-slate-600 transition-colors text-sm border border-slate-600"
												>
													View Project
												</a>
											</div>
										</div>
									</div>
								</article>
							))
						}
					</div>
				</section>

				<!-- Skills Grid -->
				<section>
					<h2 class="text-xl font-bold text-slate-100 mb-6">
						Technical Skills
					</h2>
					<div class="grid md:grid-cols-2 gap-6">
						{
							skills.map((group) => (
								<div class="bg-slate-800/30 rounded-xl p-6 border border-slate-800">
									<h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4 border-b border-slate-700 pb-2">
										{group.category}
									</h3>
									<div class="flex flex-wrap gap-2">
										{group.items.map((skill) => (
											<span class="text-sm text-slate-400 bg-slate-900 px-3 py-1 rounded-full border border-slate-700">
												{skill}
											</span>
										))}
									</div>
								</div>
							))
						}
					</div>
				</section>

				<!-- Certifications -->
				<section>
					<h2 class="text-xl font-bold text-slate-100 mb-6">
						Certifications
					</h2>
					<div class="grid gap-4">
						{
							certs.map((cert) => (
								<a
									href={cert.link}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center justify-between p-4 bg-slate-800/30 rounded-lg border border-slate-800 hover:border-blue-500/50 hover:bg-slate-800/50 transition-all cursor-pointer group"
								>
									<div>
										<h4 class="font-bold text-slate-200 group-hover:text-blue-400 transition-colors">
											{cert.name}
										</h4>
										<p class="text-sm text-slate-500">
											{cert.issuer}
										</p>
									</div>
									<div class="text-right">
										<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-500/10 text-green-500 border border-green-500/20">
											{cert.status}
										</span>
										<p class="text-xs text-slate-600 mt-1">
											{cert.date}
										</p>
									</div>
								</a>
							))
						}
					</div>
				</section>

				<div
					class="prose prose-invert max-w-none pt-8 border-t border-slate-800"
				>
					<p class="text-slate-400 text-lg">
						Check out my <a
							href="/experience"
							class="text-blue-400 hover:text-blue-300"
							>Competitions & Experience</a
						> page and <a
							href="/projects"
							class="text-blue-400 hover:text-blue-300"
							>Projects</a
						> to see my latest work and achievements.
					</p>
				</div>
			</div>
		</div>

		<!-- Sidebar -->
		<div class="space-y-8 md:space-y-12">
			<!-- Latest Articles -->
			<section>
				<h2
					class="text-lg font-bold text-slate-100 mb-6 border-b border-slate-800 pb-2"
				>
					Latest Articles
				</h2>
				<div class="space-y-6">
					{
						allPosts.map((post) => (
							<a
								href={`${import.meta.env.BASE_URL}blog/${post.slug}`}
								class="block group"
							>
								<h3 class="bg-gradient-to-r from-blue-400 to-blue-600 bg-[length:0%_2px] bg-no-repeat bg-left-bottom group-hover:bg-[length:100%_2px] transition-all duration-500 text-slate-300 group-hover:text-white font-medium mb-1 inline-block">
									{post.data.title}
								</h3>
								<div class="flex items-center gap-3 text-xs text-slate-500 font-mono mt-1">
									<span>
										{post.data.pubDate
											.toISOString()
											.slice(0, 10)}
									</span>
									{post.data.tags?.slice(0, 1).map((tag) => (
										<span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400">
											#{tag}
										</span>
									))}
								</div>
							</a>
						))
					}
					<a
						href="/blog"
						class="inline-block text-sm text-blue-500 hover:text-blue-400 font-medium"
					>
						View all posts &rarr;
					</a>
				</div>
			</section>

			<!-- Quick Skills Badge Cloud? (Optional) -->
			<section
				class="hidden md:block p-6 rounded-2xl bg-slate-800/50 border border-slate-800"
			>
				<h3
					class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-4"
				>
					Core Competencies
				</h3>
				<div class="flex flex-wrap gap-2">
					{
						[
							"Network Defense",
							"Incident Response",
							"Python",
							"PowerShell",
							"Linux/Windows",
						].map((skill) => (
							<span class="text-xs px-2 py-1 rounded-md bg-slate-900 border border-slate-700 text-slate-400">
								{skill}
							</span>
						))
					}
				</div>
			</section>
		</div>
	</div>
</Layout>
