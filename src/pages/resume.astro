---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resume | Cameron Jones">
    <div class="max-w-4xl mx-auto py-8 px-4 mb-20">
        <!-- Header: Back Link & Download Button -->
        <div
            class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        >
            <a
                href="/"
                class="text-sm font-medium text-blue-500 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
            >
                &larr; Back to Home
            </a>

            <a
                href="/resume.pdf"
                download="Cameron-Jones-Resume.pdf"
                target="_blank"
                class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-lg transition-colors flex items-center gap-2 w-fit translate-y-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" x2="12" y1="15" y2="3"></line>
                </svg>
                Download PDF
            </a>
        </div>

        <div
            class="bg-slate-800/50 rounded-xl border border-slate-700 p-1 md:p-2"
        >
            <!-- Desktop Native Viewer -->
            <iframe
                src="/resume.pdf#toolbar=0&navpanes=0&scrollbar=0"
                class="hidden md:block w-full aspect-[8.5/11] rounded-lg bg-white"
                title="Resume PDF"
            >
            </iframe>

            <!-- Mobile Canvas Viewer using PDF.js -->
            <div
                class="md:hidden relative w-full rounded-lg bg-white overflow-hidden cursor-zoom-in"
                id="pdf-container"
            >
                <p
                    id="pdf-loading"
                    class="absolute inset-0 flex items-center justify-center text-slate-800 font-medium z-10"
                >
                    Loading Resume Preview...
                </p>
                <canvas
                    id="pdf-canvas"
                    class="w-full h-auto opacity-0 transition-opacity duration-300"
                ></canvas>
            </div>
        </div>
    </div>

    <!-- Fullscreen Mobile Modal -->
    <div
        id="pdf-modal"
        class="fixed inset-0 z-[100] bg-slate-800/80 backdrop-blur-sm hidden flex-col items-center justify-center px-4 opacity-0 transition-opacity duration-300"
    >
        <div
            class="relative w-full max-w-md bg-white rounded-lg overflow-hidden shadow-2xl"
        >
            <canvas id="pdf-modal-canvas" class="w-full h-auto"></canvas>
        </div>
    </div>

    <script
        is:inline
        src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
    ></script>
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const container = document.getElementById("pdf-container");
            if (
                !container ||
                window.getComputedStyle(container).display === "none"
            ) {
                return;
            }

            // The workerSrc property shall be specified.
            pdfjsLib.GlobalWorkerOptions.workerSrc =
                "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

            const url = "/resume.pdf";
            const canvas = document.getElementById("pdf-canvas");
            const ctx = canvas.getContext("2d");
            const loadingText = document.getElementById("pdf-loading");

            // Modal elements
            const modal = document.getElementById("pdf-modal");
            const modalCanvas = document.getElementById("pdf-modal-canvas");
            const modalCtx = modalCanvas.getContext("2d");

            let pdfDoc = null;
            let pageRendering = false;
            let pageNumPending = null;
            const pageNum = 1;

            let lastContainerWidth = container.clientWidth;

            function renderPage(
                num,
                targetCanvas,
                targetCtx,
                targetContainerWidth,
            ) {
                return pdfDoc.getPage(num).then(function (page) {
                    const unscaledViewport = page.getViewport({ scale: 1.0 });
                    const scale = targetContainerWidth / unscaledViewport.width;
                    const viewport = page.getViewport({ scale: scale });

                    // Support HiDPI-screens for crisp text
                    const outputScale = window.devicePixelRatio || 1;

                    targetCanvas.width = Math.floor(
                        viewport.width * outputScale,
                    );
                    targetCanvas.height = Math.floor(
                        viewport.height * outputScale,
                    );
                    targetCanvas.style.width =
                        Math.floor(viewport.width) + "px";
                    targetCanvas.style.height =
                        Math.floor(viewport.height) + "px";

                    const transform =
                        outputScale !== 1
                            ? [outputScale, 0, 0, outputScale, 0, 0]
                            : null;

                    const renderContext = {
                        canvasContext: targetCtx,
                        transform: transform,
                        viewport: viewport,
                    };

                    return page.render(renderContext).promise.then(() => {
                        return { viewport, outputScale };
                    });
                });
            }

            function renderMainPage(num) {
                pageRendering = true;
                loadingText.style.display = "flex";

                renderPage(num, canvas, ctx, container.clientWidth)
                    .then(() => {
                        pageRendering = false;
                        loadingText.style.display = "none";
                        canvas.classList.remove("opacity-0");

                        if (pageNumPending !== null) {
                            renderMainPage(pageNumPending);
                            pageNumPending = null;
                        }
                    })
                    .catch((err) => {
                        console.error("Error rendering page:", err);
                        pageRendering = false;
                    });
            }

            function queueRenderPage(num) {
                if (pageRendering) {
                    pageNumPending = num;
                } else {
                    renderMainPage(num);
                }
            }

            let resizeTimeout;
            window.addEventListener("resize", () => {
                if (
                    window.getComputedStyle(container).display !== "none" &&
                    pdfDoc
                ) {
                    const currentWidth = container.clientWidth;
                    // Only re-render if the width actually changed. Let the browser handle height changes natively.
                    // This fixes the issue on mobile where scrolling hides/shows the address bar, changing window height.
                    if (currentWidth !== lastContainerWidth) {
                        lastContainerWidth = currentWidth;
                        clearTimeout(resizeTimeout);
                        resizeTimeout = setTimeout(() => {
                            queueRenderPage(pageNum);
                        }, 200);
                    }
                }
            });

            pdfjsLib
                .getDocument(url)
                .promise.then(function (pdfDoc_) {
                    pdfDoc = pdfDoc_;
                    renderMainPage(pageNum);
                })
                .catch((err) => {
                    console.error("Error loading PDF:", err);
                    loadingText.textContent =
                        "Failed to load preview. Please use Download button.";
                    loadingText.classList.add("text-red-500");
                });

            // Modal Logic
            function openModal() {
                if (!pdfDoc) return;

                // Show modal first to get its dimensions
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                // Small delay for display block to register before opacity transition
                setTimeout(() => {
                    modal.classList.remove("opacity-0");
                }, 10);

                document.body.classList.add("overflow-hidden");

                // Render the PDF in the modal (using the width of the modal container which has px-4 padding)
                // We use a slight delay to ensure layout is calculated after display:flex
                setTimeout(() => {
                    const modalInnerContainer = modalCanvas.parentElement;
                    renderPage(
                        pageNum,
                        modalCanvas,
                        modalCtx,
                        modalInnerContainer.clientWidth,
                    );
                }, 50);
            }

            function closeModal() {
                modal.classList.add("opacity-0");
                setTimeout(() => {
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                    document.body.classList.remove("overflow-hidden");
                }, 300); // 300ms matches Tailwind's duration-300
            }

            container.addEventListener("click", openModal);
            modal.addEventListener("click", (e) => {
                // If they click on the dark background (not the canvas/inner container), close it
                if (e.target === modal) {
                    closeModal();
                }
            });
        });
    </script>
</Layout>
