---
import Layout from "../layouts/Layout.astro";

// Generate a timestamp at build time to bust browser caches when deployed.
const buildTime = Date.now();
---

<Layout title="Resume | Cameron Jones">
    <div class="max-w-4xl mx-auto pt-0 pb-8 px-4 mb-20">
        <!-- Header: Back Link & Download Button -->
        <div
            class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        >
            <a
                href="/"
                class="text-sm font-medium text-blue-500 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
            >
                &larr; Back to Home
            </a>

            <a
                href="/resume.pdf"
                download="Cameron-Jones-Resume.pdf"
                target="_blank"
                class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-lg transition-colors flex items-center gap-2 w-fit translate-y-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" x2="12" y1="15" y2="3"></line>
                </svg>
                Download PDF
            </a>
        </div>

        <div
            class="bg-slate-800/50 rounded-xl border border-slate-700 p-1 md:p-2"
        >
            <!-- Multi-page viewer: every page is rendered before it is shown -->
            <div
                class="relative min-h-[60vh] w-full overflow-hidden rounded-lg bg-slate-900 cursor-zoom-in md:cursor-default"
                id="pdf-container"
                data-pdf-url={`/resume.pdf?v=${buildTime}`}
            >
                <p
                    id="pdf-loading"
                    class="absolute inset-0 z-10 flex items-center justify-center bg-slate-900 text-white font-medium"
                >
                    Loading Resume Preview...
                </p>
                <div
                    id="pdf-pages"
                    class="flex w-full flex-col gap-4 opacity-0 transition-opacity duration-300"
                ></div>
            </div>
        </div>
    </div>

    <!-- Fullscreen PDF Modal -->
    <div
        id="pdf-modal"
        class="fixed inset-0 z-[100] hidden overflow-y-auto bg-slate-800/80 px-3 py-4 opacity-0 backdrop-blur-sm transition-opacity duration-300 sm:px-6 sm:py-8 md:hidden"
    >
        <div
            id="pdf-modal-content"
            class="relative mx-auto w-full max-w-3xl rounded-lg bg-slate-900/90 p-3 shadow-2xl sm:p-5"
        >
            <button
                id="pdf-modal-close"
                type="button"
                class="sticky top-2 z-10 ml-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-slate-900/90 text-2xl leading-none text-white shadow-lg"
                aria-label="Close resume preview"
            >
                &times;
            </button>
            <div
                id="pdf-modal-pages"
                class="flex w-full flex-col gap-4 overflow-hidden rounded-sm"
            ></div>
        </div>
    </div>

    <script
        is:inline
        src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
    ></script>
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const container = document.getElementById("pdf-container");
            if (!container) return;

            // The workerSrc property shall be specified.
            pdfjsLib.GlobalWorkerOptions.workerSrc =
                "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

            const url = container.dataset.pdfUrl;
            const pagesContainer = document.getElementById("pdf-pages");
            const loadingText = document.getElementById("pdf-loading");

            // Modal elements
            const modal = document.getElementById("pdf-modal");
            const modalPages = document.getElementById("pdf-modal-pages");
            const modalClose = document.getElementById("pdf-modal-close");
            const mobileModalQuery = window.matchMedia("(max-width: 767px)");

            let pdfDoc = null;
            let lastContainerWidth = container.clientWidth;

            async function renderPage(num, targetContainer, targetWidth) {
                const page = await pdfDoc.getPage(num);
                const canvas = document.createElement("canvas");
                const ctx = canvas.getContext("2d");
                canvas.className = "block w-full h-auto bg-white";
                canvas.setAttribute("aria-label", `Resume page ${num}`);
                targetContainer.appendChild(canvas);

                const unscaledViewport = page.getViewport({ scale: 1.0 });
                const scale = targetWidth / unscaledViewport.width;
                const viewport = page.getViewport({ scale: scale });

                // Support HiDPI-screens for crisp text
                const outputScale = window.devicePixelRatio || 1;

                canvas.width = Math.floor(viewport.width * outputScale);
                canvas.height = Math.floor(viewport.height * outputScale);
                canvas.style.width = Math.floor(viewport.width) + "px";
                canvas.style.height = Math.floor(viewport.height) + "px";

                const transform =
                    outputScale !== 1
                        ? [outputScale, 0, 0, outputScale, 0, 0]
                        : null;

                const renderContext = {
                    canvasContext: ctx,
                    transform: transform,
                    viewport: viewport,
                };

                await page.render(renderContext).promise;
            }

            async function renderAllPages(targetContainer, targetWidth) {
                targetContainer.innerHTML = "";

                for (let pageNum = 1; pageNum <= pdfDoc.numPages; pageNum++) {
                    await renderPage(pageNum, targetContainer, targetWidth);
                }
            }

            async function renderMainPages() {
                loadingText.style.display = "flex";

                try {
                    await renderAllPages(
                        pagesContainer,
                        container.clientWidth,
                    );
                    loadingText.style.display = "none";
                    pagesContainer.classList.remove("opacity-0");
                } catch (err) {
                    console.error("Error rendering pages:", err);
                    loadingText.textContent =
                        "Failed to load preview. Please use Download button.";
                    loadingText.classList.add("text-red-500");
                }
            }

            let resizeTimeout;
            window.addEventListener("resize", () => {
                if (pdfDoc) {
                    const currentWidth = container.clientWidth;
                    // Only re-render if the width actually changed. Let the browser handle height changes natively.
                    // This fixes the issue on mobile where scrolling hides/shows the address bar, changing window height.
                    if (currentWidth !== lastContainerWidth) {
                        lastContainerWidth = currentWidth;
                        clearTimeout(resizeTimeout);
                        resizeTimeout = setTimeout(() => {
                            renderMainPages();
                        }, 200);
                    }
                }
            });

            pdfjsLib
                .getDocument(url)
                .promise.then(function (pdfDoc_) {
                    pdfDoc = pdfDoc_;
                    renderMainPages();
                })
                .catch((err) => {
                    console.error("Error loading PDF:", err);
                    loadingText.textContent =
                        "Failed to load preview. Please use Download button.";
                    loadingText.classList.add("text-red-500");
                });

            // Modal Logic
            async function openModal() {
                if (!pdfDoc || !mobileModalQuery.matches) return;

                modal.classList.remove("hidden");
                setTimeout(() => {
                    modal.classList.remove("opacity-0");
                }, 10);

                document.body.classList.add("overflow-hidden");
                await renderAllPages(modalPages, modalPages.clientWidth);
            }

            function closeModal() {
                modal.classList.add("opacity-0");
                setTimeout(() => {
                    modal.classList.add("hidden");
                    document.body.classList.remove("overflow-hidden");
                }, 300); // 300ms matches Tailwind's duration-300
            }

            container.addEventListener("click", openModal);
            modalClose.addEventListener("click", closeModal);
            modal.addEventListener("click", (event) => {
                if (event.target === modal) closeModal();
            });
            document.addEventListener("keydown", (event) => {
                if (
                    event.key === "Escape" &&
                    !modal.classList.contains("hidden")
                ) {
                    closeModal();
                }
            });
        });
    </script>
</Layout>
