---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
// Sort by date desc
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog | Cameron Jones">
    <section class="pb-10 max-w-4xl mx-auto">
        <div class="mb-8">
            <a
                href="/"
                class="text-sm font-medium text-blue-500 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
            >
                &larr; Back to Home
            </a>
        </div>
        <div
            class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 gap-4"
        >
            <h1 class="text-4xl font-bold text-slate-100">Blog</h1>
            <div class="relative w-full md:w-64">
                <input
                    type="text"
                    id="search-input"
                    placeholder="Search posts or tags..."
                    class="w-full bg-slate-800/50 border border-slate-700 rounded-lg px-4 py-2 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 transition-all text-sm"
                />
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 pointer-events-none"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
        </div>

        <div id="posts-container" class="space-y-8">
            {
                allPosts.map((post) => (
                    <article
                        class="post-item flex flex-col gap-2 border-b border-slate-800 pb-8 last:border-0 transition-opacity duration-300"
                        data-title={post.data.title.toLowerCase()}
                        data-tags={post.data.tags
                            ?.map((t: string) => "#" + t.toLowerCase())
                            .join(" ")}
                    >
                        <div class="flex items-center gap-4 text-sm text-slate-500 font-mono mb-1">
                            <span>
                                {post.data.pubDate.toISOString().slice(0, 10)}
                            </span>
                            {post.data.tags?.map((tag: any) => (
                                <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400">
                                    #{tag}
                                </span>
                            ))}
                        </div>
                        <a
                            href={`${import.meta.env.BASE_URL}blog/${post.slug}`}
                            class="group"
                        >
                            <h2 class="text-2xl font-bold text-slate-200 group-hover:text-blue-400 transition-colors mb-2">
                                {post.data.title}
                            </h2>
                            {post.data.description && (
                                <p class="text-slate-400 leading-relaxed">
                                    {post.data.description}
                                </p>
                            )}
                        </a>
                    </article>
                ))
            }
        </div>

        <div id="no-results" class="hidden text-center py-12 text-slate-500">
            <p>No posts found matching your search.</p>
        </div>
    </section>
</Layout>

<script>
    const searchInput = document.getElementById(
        "search-input",
    ) as HTMLInputElement;
    const posts = document.querySelectorAll(".post-item");
    const noResults = document.getElementById("no-results");

    searchInput?.addEventListener("input", (e) => {
        const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
        const isTagSearch = searchTerm.startsWith("#");

        // Visual feedback for tag search
        if (isTagSearch) {
            searchInput.classList.add("border-blue-500", "ring-blue-500/50");
            searchInput.classList.remove("border-slate-700");
        } else {
            searchInput.classList.remove("border-blue-500", "ring-blue-500/50");
            searchInput.classList.add("border-slate-700");
        }

        let hasVisiblePosts = false;

        posts.forEach((post) => {
            const title = (post as HTMLElement).dataset.title || "";
            const tags = (post as HTMLElement).dataset.tags || "";

            if (title.includes(searchTerm) || tags.includes(searchTerm)) {
                post.classList.remove("hidden");
                hasVisiblePosts = true;
            } else {
                post.classList.add("hidden");
            }
        });

        if (noResults) {
            if (!hasVisiblePosts) {
                noResults.classList.remove("hidden");
            } else {
                noResults.classList.add("hidden");
            }
        }
    });
</script>
