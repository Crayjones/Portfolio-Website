---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
// Sort by status (active first) then alphabetically
allProjects.sort((a, b) => {
    if (a.data.status === "active" && b.data.status !== "active") return -1;
    if (a.data.status !== "active" && b.data.status === "active") return 1;
    return a.data.title.localeCompare(b.data.title);
});
---

<Layout title="Projects | Cameron Jones">
    <section class="pb-10 max-w-4xl mx-auto">
        <div class="mb-8">
            <a
                href="/"
                class="text-sm font-medium text-blue-500 hover:text-blue-400 transition-colors inline-flex items-center gap-1"
            >
                &larr; Back to Home
            </a>
        </div>
        <div
            class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12 gap-4"
        >
            <h1 class="text-4xl font-bold text-slate-100">Projects</h1>
        </div>

        <div class="space-y-8">
            {
                allProjects.map((project) => (
                    <article class="project-item flex flex-col gap-4 border border-slate-800 rounded-xl p-6 bg-slate-800/30 hover:border-slate-700 transition-all">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <h2 class="text-2xl font-bold text-slate-200">
                                        {project.data.title}
                                    </h2>
                                    <span
                                        class={`px-2.5 py-0.5 rounded-full text-xs font-medium border ${
                                            project.data.status === "active"
                                                ? "bg-green-500/10 text-green-500 border-green-500/20"
                                                : project.data.status ===
                                                    "completed"
                                                  ? "bg-blue-500/10 text-blue-500 border-blue-500/20"
                                                  : "bg-slate-500/10 text-slate-500 border-slate-500/20"
                                        }`}
                                    >
                                        {project.data.status}
                                    </span>
                                </div>
                                <p class="text-slate-400 leading-relaxed mb-3">
                                    {project.data.description}
                                </p>
                                {project.data.tags && (
                                    <div class="flex flex-wrap gap-2 mb-3">
                                        {project.data.tags.map((tag) => (
                                            <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 text-xs border border-slate-700">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>
                        <div class="flex gap-3">
                            {project.data.link && (
                                <a
                                    href={project.data.link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-500 transition-colors text-sm"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4"
                                        fill="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                    </svg>
                                    View on GitHub
                                </a>
                            )}
                            <a
                                href={`/projects/${project.slug}`}
                                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-700 text-slate-200 font-semibold hover:bg-slate-600 transition-colors text-sm border border-slate-600"
                            >
                                View Details →
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>
</Layout>
